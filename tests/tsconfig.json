{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "rootDir": "..",
    "outDir": "../.test-dist",
    "incremental": false
  },
  "include": [
    "../src/domain/**/*.ts",
    "../src/app/api/**/*.ts",
    "../server/privacy/**/*.ts",
    "../server/policy/**/*.ts",
    "../server/persistence/**/*.ts",
    "./**/*.ts"
  ],
  "exclude": ["../node_modules"]
}
